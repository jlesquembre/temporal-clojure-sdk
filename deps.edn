{:paths ["src" "resources" "target/classes"]

 :deps/prep-lib {:alias :build
                 :fn prep
                 :ensure "target/classes"}

 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        org.clojure/core.async {:mvn/version "1.9.865"}
        org.clojure/tools.analyzer.jvm {:mvn/version "1.3.4"}
        io.temporal/temporal-shaded {:mvn/version "1.40.0"}
        com.jayway.jsonpath/json-path {:mvn/version "3.0.0"}
        com.taoensso/encore {:mvn/version "3.172.1"}
        com.taoensso/timbre {:mvn/version "6.8.0"}
        com.taoensso/nippy {:mvn/version "3.9.0"}
        funcool/promesa {:mvn/version "12.0.1"}
        metosin/jsonista {:mvn/version "1.0.1"}
        medley/medley {:mvn/version "1.4.0"}
        org.clj-commons/slingshot {:mvn/version "0.13.0"}}

 :aliases
 {:dev {:extra-paths ["test" "dev-resources" "test/temporal/test/resources"]
        :extra-deps {org.clojure/tools.namespace {:mvn/version "1.5.1"}
                     criterium/criterium {:mvn/version "0.4.6"}
                     eftest/eftest {:mvn/version "0.6.0"}
                     mockery/mockery {:mvn/version "0.1.4"}
                     io.temporal/temporal-opentracing {:mvn/version "1.40.0"}
                     io.opentracing/opentracing-mock {:mvn/version "0.33.0"}
                     same/ish {:mvn/version "0.1.7"}}}

  :build {:deps {io.github.clojure/tools.build
                 {:git/tag "v0.10.10" :git/sha "deedd62"}}
          :ns-default build}}}
